{
  "name": "subagent-view",
  "description": "DSH web extension: a live subagent run monitor with a docked left-sidebar bar + expandable panel, a conversation Subagents view, and a Subagents tab in the right sidebar",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/index.js.map",
    "lib/client.js.map",
    "cordis.patch.yml",
    "src",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dependencies": {
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-session-query": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent": ">=0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.5-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "tsdown": "^0.22.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "web",
    "subagent",
    "monitor",
    "sidebar",
    "right-sidebar"
  ]
}
